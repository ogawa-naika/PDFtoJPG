<Window x:Class="pdf_jpg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF to JPG 変換ツール v1.1.0"
        Height="400"
        Width="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="#F5F5F5">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Top">
            <!-- タイトル -->
            <TextBlock Text="PDF to JPG 変換ツール"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,18" />

            <!-- PDF ファイル選択 -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="PDFファイル："
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#333333" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PdfPathTextBox"
                             Grid.Column="0"
                             Padding="12,10"
                             IsReadOnly="True"
                             Background="White"
                             Text="ここにPDFをドラッグドロップ"
                             Foreground="#999999"
                             VerticalAlignment="Center"
                             AllowDrop="True"
                             PreviewDragOver="PdfPathTextBox_DragOver"
                             PreviewDrop="PdfPathTextBox_Drop" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="参照"
                            Margin="10,0,0,0"
                            Padding="15,10"
                            Click="BrowseButton_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold" />
                </Grid>
            </StackPanel>

            <!-- 出力先フォルダ選択 -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="出力先フォルダ："
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Foreground="#333333" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderTextBox"
                             Grid.Column="0"
                             Padding="12,10"
                             IsReadOnly="True"
                             Background="White"
                             VerticalAlignment="Center"
                             Foreground="#666666"
                             AllowDrop="True"
                             PreviewDragOver="OutputFolderTextBox_DragOver"
                             PreviewDrop="OutputFolderTextBox_Drop" />
                    <Button x:Name="OutputFolderButton"
                            Grid.Column="1"
                            Content="参照"
                            Margin="10,0,0,0"
                            Padding="15,10"
                            Click="OutputFolderButton_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold" />
                </Grid>
            </StackPanel>

            <!-- ステータス -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="準備完了"
                       FontSize="12"
                       Foreground="#666666"
                       Margin="0,5,0,10" />

            <!-- 変換ボタン -->
            <Button x:Name="ConvertButton"
                    Content="JPGに変換"
                    Padding="15,14"
                    Click="ConvertButton_Click"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>